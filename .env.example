# Database
# Example:
# - POSTGRES_USER: DB login user
# - POSTGRES_PASSWORD: DB login password
# - POSTGRES_DB: DB name
POSTGRES_USER=autosys
POSTGRES_PASSWORD=autosys
POSTGRES_DB=autosys

# Broker Mode
# - alpaca: Alpaca only
# - kis: Korea Investment & Securities Open API only
BROKER_MODE=alpaca

# Alpaca API
# Example values (DO NOT use real keys in git):
# ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXX
# ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper
# ALPACA_BASE_URL=https://api.alpaca.markets         # live
ALPACA_API_KEY=PK_YOUR_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# KIS Open API (한국투자증권)
# Example values (masked):
# KIS_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KIS_APP_SECRET=xxxxxxxxxxxxxxxx...(long secret)
# KIS_ACCOUNT_CANO=12345678           # 계좌 앞 8자리
# KIS_ACCOUNT_ACNT_PRDT_CD=01         # 계좌상품코드 2자리
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443  # 모의
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443      # 실전
# KIS_IS_PAPER=true|false
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_CANO=
KIS_ACCOUNT_ACNT_PRDT_CD=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_IS_PAPER=true
KIS_US_EXCHANGE=NASD
KIS_US_PRICE_EXCD=NAS
KIS_US_CURRENCY=USD

# Frontend API Routing (optional)
# Use a browser-reachable URL (not docker-internal hostnames).
# Example (same host):
# NEXT_PUBLIC_BACKEND_SERVER_URL=http://192.168.0.10:8000/api/v1
# If empty, frontend falls back to same-origin /api/v1
NEXT_PUBLIC_BACKEND_SERVER_URL=
NEXT_PUBLIC_BACKEND_PORT=8000
NEXT_PUBLIC_BACKEND_SERVER_URL_DEV=
NEXT_PUBLIC_BACKEND_PORT_DEV=8002

# System
LOG_LEVEL=INFO
ENVIRONMENT=development
