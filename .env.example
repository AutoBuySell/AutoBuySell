# Database
# Example:
# - POSTGRES_USER: DB login user
# - POSTGRES_PASSWORD: DB login password
# - POSTGRES_DB: DB name
POSTGRES_USER=autosys
POSTGRES_PASSWORD=autosys
POSTGRES_DB=autosys

# Broker Mode (legacy single-account fallback)
# - alpaca: Alpaca only
# - kis: Korea Investment & Securities Open API only
# NOTE: If BROKER_ACCOUNTS is set, BROKER_MODE and legacy credential env vars are ignored.
BROKER_MODE=alpaca

# Multi-account (JSON)
# Put ALL account definitions in one JSON array string.
# You can include a human-friendly description in config.description,
# and the UI can show it at the top as current account context.
#
# Included examples below:
# - KIS live account (실전)
# - KIS paper/mock account (모의)
# - Alpaca live account
# - Alpaca paper account
BROKER_ACCOUNTS=[{"name":"kis-live-1","broker_type":"kis","credentials":{"app_key":"KIS_LIVE_APP_KEY","app_secret":"KIS_LIVE_APP_SECRET","cano":"12345678","acnt_prdt_cd":"01"},"config":{"base_url":"https://openapi.koreainvestment.com:9443","is_paper":false,"us_exchange":"NASD","us_price_excd":"NAS","us_currency":"USD","description":"KIS 실전계좌 #1 (US swing, conservative risk)"}},{"name":"kis-paper-1","broker_type":"kis","credentials":{"app_key":"KIS_PAPER_APP_KEY","app_secret":"KIS_PAPER_APP_SECRET","cano":"87654321","acnt_prdt_cd":"01"},"config":{"base_url":"https://openapivts.koreainvestment.com:29443","is_paper":true,"us_exchange":"NASD","us_price_excd":"NAS","us_currency":"USD","description":"KIS 모의계좌 #1 (strategy validation)"}},{"name":"alpaca-live-1","broker_type":"alpaca","credentials":{"api_key":"ALPACA_LIVE_API_KEY","secret_key":"ALPACA_LIVE_SECRET_KEY"},"config":{"base_url":"https://api.alpaca.markets","description":"Alpaca 실전계좌 #1 (US equities live)"}},{"name":"alpaca-paper-1","broker_type":"alpaca","credentials":{"api_key":"ALPACA_PAPER_API_KEY","secret_key":"ALPACA_PAPER_SECRET_KEY"},"config":{"base_url":"https://paper-api.alpaca.markets","description":"Alpaca paper계좌 #1 (paper trading sandbox)"}}]

# Alpaca API
# Example values (DO NOT use real keys in git):
# ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXXXX
# ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper
# ALPACA_BASE_URL=https://api.alpaca.markets         # live
ALPACA_API_KEY=PK_YOUR_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# KIS Open API (한국투자증권)
# Example values (masked):
# KIS_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KIS_APP_SECRET=xxxxxxxxxxxxxxxx...(long secret)
# KIS_ACCOUNT_CANO=12345678           # 계좌 앞 8자리
# KIS_ACCOUNT_ACNT_PRDT_CD=01         # 계좌상품코드 2자리
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443  # 모의
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443      # 실전
# KIS_IS_PAPER=true|false
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_CANO=
KIS_ACCOUNT_ACNT_PRDT_CD=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_IS_PAPER=true
KIS_US_EXCHANGE=NASD
KIS_US_PRICE_EXCD=NAS
KIS_US_CURRENCY=USD

# Frontend API Routing (optional)
# Use a browser-reachable URL (not docker-internal hostnames).
# Example (same host):
# NEXT_PUBLIC_BACKEND_SERVER_URL=http://192.168.0.10:8000/api/v1
# If empty, frontend falls back to same-origin /api/v1
NEXT_PUBLIC_BACKEND_SERVER_URL=
NEXT_PUBLIC_BACKEND_PORT=8000
NEXT_PUBLIC_BACKEND_SERVER_URL_DEV=
NEXT_PUBLIC_BACKEND_PORT_DEV=8002

# System
LOG_LEVEL=INFO
ENVIRONMENT=development
